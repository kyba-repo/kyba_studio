// ==================== EVENT HANDLERS ====================
ipcMain.handle('handleClick', async (event, ws, sec, edit) => {
  if (edit) return { error: 'El editor está activado, no se puede manejar clics.' };
  console.log('Click detectado');
  return { message: 'Click procesado correctamente', ws };
});

ipcMain.handle('handleChange', async (event, ws, sec, edit, newValue) => {
  if (edit) return { error: 'El editor está activado, no se puede manejar cambios.' };
  const items = ws[sec] || [];
  const inputIdx = items.findIndex(item => item.tipo === 'inputText');
  if (inputIdx !== -1) {
    items[inputIdx].text = newValue || 'Nuevo valor';
    ws[sec] = items;
  }
  return { message: 'Cambio procesado correctamente', ws };
});

ipcMain.handle('handleSubmit', async (event, ws, sec, edit) => {
  if (edit) return { error: 'El editor está activado, no se puede enviar formulario.' };
  const items = ws[sec] || [];
  const formData = {};
  items.forEach(item => {
    if (item.tipo === 'inputText') {
      formData[item.text] = item.text || 'Valor por defecto';
    }
  });
  console.log('Formulario enviado:', formData);
  return { message: 'Formulario enviado correctamente', data: formData, ws };
});

ipcMain.handle('handleLoad', async (event, ws, sec, edit) => {
