  if (edit) return { error: 'El editor está activado, no se puede mostrar spinner.' };
  console.log('Mostrando spinner');
  return { message: 'Spinner activado', loading: true, ws };
});

ipcMain.handle('hideSpinner', async (event, ws, sec, edit) => {
  if (edit) return { error: 'El editor está activado, no se puede ocultar spinner.' };
  console.log('Ocultando spinner');
  return { message: 'Spinner desactivado', loading: false, ws };
});

ipcMain.handle('toggleSection', async (event, ws, sec, edit, sectionId) => {
  if (edit) return { error: 'El editor está activado, no se puede alternar sección.' };
  const items = ws[sec] || [];
  const accordionIdx = items.findIndex(item => item.tipo === 'accordion');
  if (accordionIdx !== -1) {
    if (!items[accordionIdx].expandedSections) items[accordionIdx].expandedSections = [];
    const sectionIndex = items[accordionIdx].expandedSections.indexOf(sectionId);
    if (sectionIndex > -1) {
      items[accordionIdx].expandedSections.splice(sectionIndex, 1);
    } else {
      items[accordionIdx].expandedSections.push(sectionId);
    }
    ws[sec] = items;
  }
  return { message: `Sección ${sectionId} alternada`, ws };
});

ipcMain.handle('validateForm', async (event, ws, sec, edit) => {
  if (edit) return { error: 'El editor está activado, no se puede validar formulario.' };
  const items = ws[sec] || [];
  const validationErrors = [];
  
  items.forEach((item, index) => {
    if (item.tipo === 'inputText' && (!item.text || item.text.trim() === '')) {
      validationErrors.push(`Campo ${index + 1} es requerido`);
    }
  });
  
  const isValid = validationErrors.length === 0;
  return { 
    message: isValid ? 'Formulario válido' : 'Formulario con errores', 
    valid: isValid, 
    errors: validationErrors, 
    ws 
  };
});

ipcMain.handle('resetForm', async (event, ws, sec, edit) => {
  if (edit) return { error: 'El editor está activado, no se puede limpiar formulario.' };
  const items = ws[sec] || [];
  
  items.forEach(item => {
    if (item.tipo === 'inputText') {
      item.text = '';
    } else if (item.tipo === 'combobox') {
      item.selectedValue = '';
    }
  });
  
  ws[sec] = items;
  return { message: 'Formulario limpiado', ws };
});

// ==================== UTILITY FUNCTIONS ====================
ipcMain.handle('formatData', async (event, ws, sec, edit, data, format) => {
  if (edit) return { error: 'El editor está activado, no se puede formatear datos.' };
  let formattedData = data;
  
  switch (format) {
    case 'currency':
      formattedData = `$${parseFloat(data || 0).toFixed(2)}`;
      break;
    case 'date':
      formattedData = new Date(data).toLocaleDateString();
      break;
    case 'uppercase':
      formattedData = data?.toString().toUpperCase();
      break;
    case 'lowercase':
      formattedData = data?.toString().toLowerCase();
      break;
    default:
      formattedData = data;
  }
  
  return { message: 'Datos formateados', formattedData, ws };
});

ipcMain.handle('parseData', async (event, ws, sec, edit, data, parseType) => {
  if (edit) return { error: 'El editor está activado, no se pueden parsear datos.' };
  let parsedData = data;
  
  try {
    switch (parseType) {
      case 'json':
        parsedData = JSON.parse(data);
        break;
      case 'number':
        parsedData = parseFloat(data);
        break;
      case 'date':
        parsedData = new Date(data);
        break;
      default:
        parsedData = data;
    }
  } catch (error) {
    return { error: 'Error al parsear datos', ws };
  }
  
  return { message: 'Datos parseados', parsedData, ws };
});

ipcMain.handle('calculateValues', async (event, ws, sec, edit, operation, values) => {
  if (edit) return { error: 'El editor está activado, no se pueden realizar cálculos.' };
  let result = 0;
  const numbers = values?.map(v => parseFloat(v) || 0) || [];
  
  switch (operation) {
    case 'sum':
      result = numbers.reduce((a, b) => a + b, 0);
      break;
    case 'average':
      result = numbers.length > 0 ? numbers.reduce((a, b) => a + b, 0) / numbers.length : 0;
      break;
    case 'max':
      result = Math.max(...numbers);
      break;
    case 'min':
      result = Math.min(...numbers);
      break;
    case 'count':
      result = numbers.length;
      break;
    default:
      result = numbers[0] || 0;
  }
  
  return { message: 'Cálculo completado', result, operation, ws };
});

ipcMain.handle('transformData', async (event, ws, sec, edit, data, transformation) => {
  if (edit) return { error: 'El editor está activado, no se pueden transformar datos.' };
  let transformedData = data;
  
  switch (transformation) {
    case 'flatten':
      transformedData = Array.isArray(data) ? data.flat() : data;
      break;
    case 'unique':
      transformedData = Array.isArray(data) ? [...new Set(data)] : data;
      break;
    case 'sort':
      transformedData = Array.isArray(data) ? data.sort() : data;
      break;
    case 'reverse':
      transformedData = Array.isArray(data) ? data.reverse() : data;
      break;
    default:
      transformedData = data;
  }
  
  return { message: 'Datos transformados', transformedData, ws };
});

ipcMain.handle('validateInput', async (event, ws, sec, edit, input, rules) => {
  if (edit) return { error: 'El editor está activado, no se puede validar entrada.' };
  const validationResults = [];
  
  if (rules?.required && (!input || input.toString().trim() === '')) {
    validationResults.push('Campo requerido');
  }
  
  if (rules?.minLength && input?.toString().length < rules.minLength) {
    validationResults.push(`Mínimo ${rules.minLength} caracteres`);
  }
  
  if (rules?.maxLength && input?.toString().length > rules.maxLength) {
    validationResults.push(`Máximo ${rules.maxLength} caracteres`);
  }
  
  if (rules?.email && !/\S+@\S+\.\S+/.test(input)) {
    validationResults.push('Email inválido');
  }
  
  const isValid = validationResults.length === 0;
  return { message: isValid ? 'Entrada válida' : 'Entrada inválida', valid: isValid, errors: validationResults, ws };
});

ipcMain.handle('sanitizeData', async (event, ws, sec, edit, data) => {
  if (edit) return { error: 'El editor está activado, no se pueden limpiar datos.' };
  let sanitizedData = data;
  
  if (typeof data === 'string') {
    sanitizedData = data
      .replace(/<script\b[^<]*(?:(?!<\/script>)<[^<]*)*<\/script>/gi, '') // Remove scripts
      .replace(/[<>]/g, '') // Remove < and >
      .trim();
  }
  
  return { message: 'Datos limpiados', sanitizedData, ws };
});

