const { app, BrowserWindow, BrowserView, shell, ipcMain } = require('electron');
const prompt = require('electron-prompt');
const path = require('path');

// Cargar variables de entorno para S3
try {
  require('dotenv').config();
  console.log('Environment variables loaded');
} catch (error) {
  console.warn('dotenv not installed, skipping environment variables');
}

// AWS S3 imports - Instalar con: npm install @aws-sdk/client-s3 @aws-sdk/credential-providers
try {
  const { S3Client, GetObjectCommand, ListObjectsV2Command } = require('@aws-sdk/client-s3');
  const { fromEnv } = require('@aws-sdk/credential-providers');
  module.exports.S3Client = S3Client;
  module.exports.GetObjectCommand = GetObjectCommand;
  module.exports.ListObjectsV2Command = ListObjectsV2Command;
  module.exports.fromEnv = fromEnv;
  console.log('AWS SDK loaded successfully');
} catch (error) {
  console.warn('AWS SDK not installed, S3 functionality will be disabled:', error.message);
}

// ==================== S3 CONFIGURATION ====================
let s3Client = null;
const s3Cache = new Map();
const CACHE_DURATION = 5 * 60 * 1000; // 5 minutos

// Inicializar cliente S3
const initializeS3Client = () => {
  try {
    if (!module.exports.S3Client || !module.exports.fromEnv) {
      console.warn('AWS SDK not available, S3 functionality disabled');
      return false;
    }
    
    // Verificar si las credenciales están disponibles
    if (!process.env.AWS_ACCESS_KEY_ID || !process.env.AWS_SECRET_ACCESS_KEY) {
      console.warn('AWS credentials not found in environment variables');
      console.log('S3 functionality will be disabled. Set AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY to enable S3 features');
      return false;
    }
    
    const { S3Client, fromEnv } = module.exports;
    s3Client = new S3Client({
      region: process.env.AWS_REGION || 'us-east-1',
      credentials: fromEnv(), // Lee AWS_ACCESS_KEY_ID y AWS_SECRET_ACCESS_KEY del entorno
    });
    console.log('Cliente S3 inicializado correctamente');
    return true;
  } catch (error) {
    console.warn('Error inicializando cliente S3:', error.message);
    console.log('La aplicación continuará sin funcionalidad S3');
    s3Client = null;
    return false;
  }
};

// Función auxiliar para convertir stream a string
const streamToString = (stream) => {
  return new Promise((resolve, reject) => {
    const chunks = [];
    stream.on('data', (chunk) => chunks.push(chunk));
    stream.on('error', reject);
    stream.on('end', () => resolve(Buffer.concat(chunks).toString('utf8')));
  });
};

// ==================== S3 DATA FUNCTIONS ====================
// Función para obtener datos de S3
const getS3Data = async (bucket, key) => {
  const cacheKey = `${bucket}/${key}`;
  
  // Verificar cache
  if (s3Cache.has(cacheKey)) {
    const cached = s3Cache.get(cacheKey);
    if (Date.now() - cached.timestamp < CACHE_DURATION) {
      console.log(`Datos S3 obtenidos del cache: ${cacheKey}`);
      return cached.data;
    }
  }
  
  try {
    if (!s3Client) {
      throw new Error('S3 client not initialized. S3 functionality is disabled.');
    }
    
    if (!module.exports.GetObjectCommand) {
      throw new Error('AWS SDK not available.');
    }
    
    console.log(`Obteniendo datos de S3: s3://${bucket}/${key}`);
    
    const { GetObjectCommand } = module.exports;
    const command = new GetObjectCommand({
      Bucket: bucket,
      Key: key
    });
    
    const response = await s3Client.send(command);
    const bodyString = await streamToString(response.Body);
    const data = JSON.parse(bodyString);
    
    // Guardar en cache

// Listar objetos en S3
const listS3Objects = async (bucket, prefix = '') => {
  try {
    if (!s3Client) {
      throw new Error('S3 client not initialized. S3 functionality is disabled.');
    }
    
    if (!module.exports.ListObjectsV2Command) {
      throw new Error('AWS SDK not available.');
    }
    
    console.log(`Listando objetos S3: s3://${bucket}/${prefix}`);
    
    const { ListObjectsV2Command } = module.exports;
    const command = new ListObjectsV2Command({
      Bucket: bucket,
      Prefix: prefix,
      MaxKeys: 100
    });
    
    const response = await s3Client.send(command);
    const objects = response.Contents || [];
    
    console.log(`Se encontraron ${objects.length} objetos en S3`);
    return objects;
  } catch (error) {
    console.error(`Error listando objetos S3 ${bucket}:`, error.message);
    throw error;
  }
};

ipcMain.handle('show-prompt', async (event, options) => {
  try {
    const result = await prompt(options);
    return result;
  } catch (e) {
    return null;
  }
});

let mainWindow;
let chatWindow = null;
let chatView = null;
let chatPanelVisible = false;

function createWindow() {
  console.log('Creating main window...');
  
  mainWindow = new BrowserWindow({
    backgroundColor: '#eef4ff',
    icon: path.join(__dirname),
    webPreferences: {
      preload: path.join(__dirname, 'preload.js'),
      contextIsolation: true,
      nodeIntegration: false,
      sandbox: true
    },
    show: false // No mostrar hasta que esté completamente listo
  });

  console.log('Main window created, maximizing...');
  // Maximizar inmediatamente después de crear la ventana
  mainWindow.maximize();

  console.log('Loading index.html...');
  mainWindow.loadFile(path.join(__dirname, 'renderer', 'index.html'));

  mainWindow.webContents.setWindowOpenHandler(({ url }) => {
    shell.openExternal(url);
    return { action: 'deny' };
  });

  mainWindow.once('ready-to-show', async () => {
    console.log('Main window ready-to-show event triggered');
    
    // Configurar ChatGPT view
    console.log('Setting up ChatGPT view...');
    chatView = new BrowserView({
      webPreferences: {
        contextIsolation: true,
        nodeIntegration: false,
        sandbox: true
      }
    });
    mainWindow.setBrowserView(chatView);

    const setChatViewBounds = () => {
      const bounds = mainWindow.getContentBounds();
      const width = 650; // Ancho fijo de 650px
      if (chatPanelVisible) {
        chatView.setBounds({ x: bounds.width - width, y: 0, width, height: bounds.height });
        chatView.setAutoResize({ width: false, height: true });
      } else {
        chatView.setBounds({ x: bounds.width, y: 0, width: 0, height: bounds.height });
      }
    };
    setChatViewBounds();
    mainWindow.on('resize', setChatViewBounds);

    // Cargar ChatGPT
    try {
      await chatView.webContents.loadURL('https://chatgpt.com');
    } catch (e) {
      console.error('Error loading ChatGPT:', e);
    }

    // NO mostrar la ventana aquí - esperar señal desde el renderer
  });

  
  // Función para animar el deslizamiento del panel ChatGPT (rápida)
  const animateChatPanel = (show) => {
    if (!chatView) return;
    
    const bounds = mainWindow.getContentBounds();
    const width = 650;
    const duration = 150; // Animación más rápida: 150ms
    const steps = 20; // Menos pasos para mayor velocidad
    const stepDuration = duration / steps;
    
    let currentStep = 0;
    
    const animate = () => {
      const progress = currentStep / steps;
      // Usar easing función para suavizar la animación
      const easeProgress = show ? 
        1 - Math.pow(1 - progress, 2) : // ease-out más rápido
        Math.pow(progress, 2); // ease-in más rápido
      
      const currentWidth = show ? width * easeProgress : width * (1 - easeProgress);
      const currentX = bounds.width - currentWidth;
      
      chatView.setBounds({ 
        x: Math.round(currentX), 
        y: 0, 
        width: Math.round(currentWidth), 
        height: bounds.height 
      });
      
      if (currentStep < steps) {
        currentStep++;
        setTimeout(animate, stepDuration);
      } else {
        // Al finalizar la animación
        if (show) {
          chatView.setAutoResize({ width: false, height: true });
        }
      }
    };
    
    animate();
  };

  ipcMain.on('toggle-chat-panel', () => {
    if (!chatView) return;
    chatPanelVisible = !chatPanelVisible;
    
    // Usar animación en lugar de cambio brusco
    animateChatPanel(chatPanelVisible);
    
    // Notificar al renderer sobre el cambio de estado
    if (mainWindow) {
      mainWindow.webContents.send('chat-panel-toggled', chatPanelVisible);
    }
  });

  // Handler para mostrar la ventana cuando el contenido esté completamente cargado
  ipcMain.on('content-ready', () => {
    console.log('Content ready signal received from renderer');
    if (mainWindow) {
      console.log('Showing main window...');
      mainWindow.show();
      mainWindow.focus(); // Asegurar que tenga foco
    } else {
      console.error('Main window not available when content-ready received');
    }
  });
  
  // Fallback: mostrar ventana después de un timeout si no se recibe content-ready
  setTimeout(() => {
    if (mainWindow && !mainWindow.isVisible()) {
      console.warn('Fallback: Showing window after timeout (content-ready not received)');
      mainWindow.show();
    }
  }, 6000); // Esperar 6 segundos máximo
}

// ==================== S3 IPC HANDLERS ====================
// Handler para obtener datos de S3
ipcMain.handle('s3-get-data', async (event, bucket, key) => {
  try {
    const data = await getS3Data(bucket, key);
    return { success: true, data };
  } catch (error) {
    return { success: false, error: error.message };
  }
});

// Handler para listar objetos en S3
ipcMain.handle('s3-list-objects', async (event, bucket, prefix) => {
  try {
    const objects = await listS3Objects(bucket, prefix);
    return { success: true, data: objects };
  } catch (error) {
    return { success: false, error: error.message };
  }
});

// Handler para limpiar cache S3
ipcMain.handle('s3-clear-cache', async (event) => {
  try {
    const cacheSize = s3Cache.size;
    s3Cache.clear();
    console.log(`Cache S3 limpiado (${cacheSize} entradas eliminadas)`);
    return { success: true, message: `Cache S3 limpiado (${cacheSize} entradas)` };
  } catch (error) {
    return { success: false, error: error.message };
  }
});

// Handler para verificar estado de S3
ipcMain.handle('s3-status', async (event) => {
  try {
    const status = {
      clientInitialized: s3Client !== null,
      cacheEntries: s3Cache.size,
      region: process.env.AWS_REGION || 'us-east-1',
      hasCredentials: !!(process.env.AWS_ACCESS_KEY_ID && process.env.AWS_SECRET_ACCESS_KEY)
    };
    return { success: true, status };
  } catch (error) {
    return { success: false, error: error.message };
  }
});

// ==================== LOCALSTORAGE HANDLERS ====================
const fs = require('fs');
const os = require('os');

// Crear directorio para almacenamiento local
const appDataPath = path.join(os.homedir(), '.shellflow');
const localStoragePath = path.join(appDataPath, 'localStorage.json');

// Asegurar que el directorio existe
if (!fs.existsSync(appDataPath)) {
  fs.mkdirSync(appDataPath, { recursive: true });
}

// Cargar localStorage desde archivo
let localStorageData = {};
try {
  if (fs.existsSync(localStoragePath)) {
    const data = fs.readFileSync(localStoragePath, 'utf8');
    localStorageData = JSON.parse(data);
  }
} catch (error) {
  console.warn('Error loading localStorage data:', error.message);
  localStorageData = {};
}

// Guardar localStorage en archivo
const saveLocalStorage = () => {
  try {
    fs.writeFileSync(localStoragePath, JSON.stringify(localStorageData, null, 2));
  } catch (error) {
    console.error('Error saving localStorage data:', error.message);
  }
};

// Handler para getItem
ipcMain.handle('localStorage-getItem', async (event, key) => {
  try {
    return localStorageData[key] || null;
  } catch (error) {
    console.error('Error getting localStorage item:', error.message);
    return null;
  }
});

// Handler para setItem
ipcMain.handle('localStorage-setItem', async (event, key, value) => {
  try {
    localStorageData[key] = value;
    saveLocalStorage();
    return true;
  } catch (error) {
    console.error('Error setting localStorage item:', error.message);
    return false;
  }
});

// Handler para removeItem
ipcMain.handle('localStorage-removeItem', async (event, key) => {
  try {
    delete localStorageData[key];
    saveLocalStorage();
    return true;
  } catch (error) {
    console.error('Error removing localStorage item:', error.message);
    return false;
  }
});

// Handler para clear
ipcMain.handle('localStorage-clear', async (event) => {
  try {
    localStorageData = {};
    saveLocalStorage();
    return true;
  } catch (error) {
    console.error('Error clearing localStorage:', error.message);
    return false;
  }
});

app.on('ready', () => {
  createWindow();
  // Inicializar S3 al arrancar la aplicación (opcional)
  const s3Initialized = initializeS3Client();
  if (s3Initialized) {
    console.log('Application started with S3 functionality enabled');
  } else {
    console.log('Application started without S3 functionality');
  }
});

app.on('window-all-closed', () => {
  if (process.platform !== 'darwin') {
    app.quit();
  }
});

app.on('activate', () => {
  if (BrowserWindow.getAllWindows().length === 0) {
    createWindow();
  }
});

ipcMain.handle('registrar-pago', async (event, ws, sec, edit) => {
  if (edit) return { error: 'El editor está activado, no se puede registrar pago.' };
  // Buscar la tabla en la pestaña actual
  const items = ws[sec] || [];
  const tablaIdx = items.findIndex(item => item.tipo === 'table' || item.tipo === 'datatable');
  if (tablaIdx === -1) return { error: 'No hay tabla en la pestaña actual.' };
  // Sumar una fila inventada
  const nuevaFila = [
    'Pago ' + (items[tablaIdx].rows ? items[tablaIdx].rows.length + 1 : 1),
    '20/08/2025',
    '$1000',
    'Aprobado'
  ];
  if (!items[tablaIdx].rows) items[tablaIdx].rows = [];
  items[tablaIdx].rows.push(nuevaFila);
  ws[sec] = items;
  return { ws };
});

