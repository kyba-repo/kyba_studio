  return { message: 'Selección procesada correctamente', selected: selectedItem, ws };
});

ipcMain.handle('handleToggle', async (event, ws, sec, edit) => {
  if (edit) return { error: 'El editor está activado, no se puede alternar estado.' };
  const items = ws[sec] || [];
  const buttonIdx = items.findIndex(item => item.tipo === 'button');
  if (buttonIdx !== -1) {
    items[buttonIdx].text = items[buttonIdx].text === 'ON' ? 'OFF' : 'ON';
    ws[sec] = items;
  }
  return { message: 'Estado alternado correctamente', ws };
});

// ==================== DATA OPERATIONS ====================
ipcMain.handle('handleSearch', async (event, ws, sec, edit, searchTerm) => {
  if (edit) return { error: 'El editor está activado, no se puede buscar.' };
  const items = ws[sec] || [];
  const tableIdx = items.findIndex(item => item.tipo === 'table');
  if (tableIdx !== -1 && items[tableIdx].rows) {
    const filteredRows = items[tableIdx].rows.filter(row => 
      row.some(cell => cell.toString().toLowerCase().includes((searchTerm || '').toLowerCase()))
    );
    return { message: 'Búsqueda completada', results: filteredRows, ws };
  }
  return { message: 'No hay tabla para buscar', results: [], ws };
});

ipcMain.handle('handleFilter', async (event, ws, sec, edit, filterCriteria) => {
  if (edit) return { error: 'El editor está activado, no se puede filtrar.' };
  const items = ws[sec] || [];
  const tableIdx = items.findIndex(item => item.tipo === 'table');
  if (tableIdx !== -1 && items[tableIdx].rows) {
    const filteredRows = items[tableIdx].rows.filter(row => {
      // Filtro simple por criterio
      return row.some(cell => cell.toString().includes(filterCriteria || ''));
    });
    items[tableIdx].filteredRows = filteredRows;
    ws[sec] = items;
  }
  return { message: 'Filtros aplicados correctamente', ws };
});

ipcMain.handle('handleSort', async (event, ws, sec, edit, column, direction) => {
  if (edit) return { error: 'El editor está activado, no se puede ordenar.' };
  const items = ws[sec] || [];
  const tableIdx = items.findIndex(item => item.tipo === 'table');
  if (tableIdx !== -1 && items[tableIdx].rows) {
    const columnIdx = column || 0;
    items[tableIdx].rows.sort((a, b) => {
      if (direction === 'desc') {
        return b[columnIdx]?.toString().localeCompare(a[columnIdx]?.toString());
      }
      return a[columnIdx]?.toString().localeCompare(b[columnIdx]?.toString());
    });
    ws[sec] = items;
  }
  return { message: 'Datos ordenados correctamente', ws };
});

ipcMain.handle('loadData', async (event, ws, sec, edit) => {
  if (edit) return { error: 'El editor está activado, no se puede cargar datos.' };
  const items = ws[sec] || [];
  const tableIdx = items.findIndex(item => item.tipo === 'table');
  if (tableIdx !== -1) {
    // Simular carga de datos
    items[tableIdx].rows = [
      ['Cliente A', '2025-01-15', '$2500', 'Activo'],
      ['Cliente B', '2025-01-20', '$1800', 'Pendiente'],
      ['Cliente C', '2025-01-25', '$3200', 'Completado']
    ];
    ws[sec] = items;
  }
  return { message: 'Datos iniciales cargados correctamente', ws };
});

ipcMain.handle('fetchRecords', async (event, ws, sec, edit, recordType) => {
  if (edit) return { error: 'El editor está activado, no se pueden obtener registros.' };
  console.log('Obteniendo registros de tipo:', recordType);
  const mockRecords = [
    { id: '1', name: 'Registro 1', type: recordType || 'Account' },
    { id: '2', name: 'Registro 2', type: recordType || 'Account' },
    { id: '3', name: 'Registro 3', type: recordType || 'Account' }
  ];
  return { message: 'Registros obtenidos correctamente', records: mockRecords, ws };
});

ipcMain.handle('createRecord', async (event, ws, sec, edit, recordData) => {
  if (edit) return { error: 'El editor está activado, no se pueden crear registros.' };
  const items = ws[sec] || [];
  const tableIdx = items.findIndex(item => item.tipo === 'table');
  if (tableIdx !== -1) {
    if (!items[tableIdx].rows) items[tableIdx].rows = [];
    const newRecord = [
      recordData?.name || 'Nuevo Registro',
      new Date().toLocaleDateString(),
      recordData?.amount || '$0',
      recordData?.status || 'Nuevo'
    ];
    items[tableIdx].rows.push(newRecord);
    ws[sec] = items;
  }
  return { message: 'Registro creado correctamente', record: recordData, ws };
});

ipcMain.handle('updateRecord', async (event, ws, sec, edit, recordId, updateData) => {
  if (edit) return { error: 'El editor está activado, no se pueden actualizar registros.' };
  const items = ws[sec] || [];
  const tableIdx = items.findIndex(item => item.tipo === 'table');
  if (tableIdx !== -1 && items[tableIdx].rows) {
    const recordIdx = parseInt(recordId) || 0;
    if (items[tableIdx].rows[recordIdx]) {
      items[tableIdx].rows[recordIdx][0] = updateData?.name || items[tableIdx].rows[recordIdx][0];
      items[tableIdx].rows[recordIdx][3] = updateData?.status || items[tableIdx].rows[recordIdx][3];
      ws[sec] = items;
    }
  }
  return { message: 'Registro actualizado correctamente', ws };
});

ipcMain.handle('deleteRecord', async (event, ws, sec, edit, recordId) => {
  if (edit) return { error: 'El editor está activado, no se pueden eliminar registros.' };
  const items = ws[sec] || [];
  const tableIdx = items.findIndex(item => item.tipo === 'table');
  if (tableIdx !== -1 && items[tableIdx].rows) {
    const recordIdx = parseInt(recordId) || 0;
    if (items[tableIdx].rows[recordIdx]) {
      items[tableIdx].rows.splice(recordIdx, 1);
      ws[sec] = items;
    }
  }
  return { message: 'Registro eliminado correctamente', ws };
});

