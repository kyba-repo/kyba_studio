ipcMain.handle('handleSave', async (event, ws, sec, edit) => {
  if (edit) return { error: 'El editor está activado, no se puede guardar.' };
  console.log('Guardando datos...');
  return { message: 'Datos guardados correctamente', ws };
});

ipcMain.handle('handleDelete', async (event, ws, sec, edit) => {
  if (edit) return { error: 'El editor está activado, no se puede eliminar.' };
  const items = ws[sec] || [];
  const tableIdx = items.findIndex(item => item.tipo === 'table');
  if (tableIdx !== -1 && items[tableIdx].rows && items[tableIdx].rows.length > 0) {
    items[tableIdx].rows.pop(); // Eliminar última fila
    ws[sec] = items;
  }
  return { message: 'Registro eliminado correctamente', ws };
});

ipcMain.handle('handleCancel', async (event, ws, sec, edit) => {
